NODE_ENV=development
PORT=7310
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/agentslave
OBJECT_STORE_ROOT=/Users/you/Documents/agentslave/data/objects
OBJECT_STORE_BASE_URL=

INCUS_PROJECT=agentslave
INCUS_IMAGE=agentslave-openhands
INCUS_BASE_IMAGE=images:ubuntu/24.04/cloud
INCUS_PROFILE=default
INCUS_AGENT_PORT=8000
INCUS_CPU=4
INCUS_MEMORY=8GiB
INCUS_AUTO_DELETE=false

SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=
SLACK_BUG_CHANNELS=

GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

OPENHANDS_API_KEY=
OPENHANDS_LLM_MODEL=gpt-5.5
OPENHANDS_LLM_API_KEY=
OPENHANDS_LLM_BASE_URL=

WORKER_ENABLED=true
WORKER_POLL_MS=2000
